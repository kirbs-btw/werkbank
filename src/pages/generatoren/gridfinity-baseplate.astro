---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getGenerator } from '../../lib/generators';
import { breadcrumbLd, faqLd } from '../../lib/schema';
import { SITE } from '../../config/site';
import { buildBaseplate, baseplatePreviewSvg, GF, PLATE, SOCKET_RELIEF, type BaseplateSpec } from '../../lib/gridfinity';

const gen = getGenerator('gridfinity-baseplate')!;
const path = '/generatoren/gridfinity-baseplate';
const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Generatoren', href: '/kategorie/generatoren' },
  { name: gen.shortTitle ?? gen.title, href: path },
];

const FAQ = [
  {
    q: 'Wofür brauche ich eine Grundplatte?',
    a: 'Die Grundplatte ist das Raster, in das die Bins einrasten. Sie verhindert, dass die Behälter in der Schublade verrutschen, und sorgt dafür, dass alles bündig ausgerichtet bleibt. Ohne Grundplatte funktionieren Gridfinity-Bins zwar auch – sie stehen dann aber lose herum und der eigentliche Vorteil des Systems geht verloren.',
  },
  {
    q: 'Wie groß darf eine Grundplatte sein?',
    a: 'Rein rechnerisch beliebig, praktisch begrenzt der Bauraum. Ein Feld misst 42 mm, damit passen auf ein 220-mm-Druckbett fünf Felder je Richtung. Größere Flächen legst du einfach aus mehreren Platten zusammen – die Außenmaße sind exakte Vielfache von 42 mm, sodass mehrere Platten nahtlos aneinander passen.',
  },
  {
    q: 'Mit oder ohne Boden drucken?',
    a: 'Ohne Boden ist die Standardvariante: Sie braucht am wenigsten Material und Zeit, und du kannst durch das Raster hindurchgreifen. Ein Boden macht die Platte steifer und verhindert, dass Kleinteile durchfallen – sinnvoll bei großen Platten oder wenn die Platte lose auf einem Tisch liegt. Für den Boden reichen 1,2 bis 2 mm.',
  },
  {
    q: 'Wie viel Luft haben die Bins in der Fassung?',
    a: 'Rund 0,20 mm je Seite. Die Spezifikation nennt 0,25 mm; die Fassung ist hier um 0,05 mm je Seite zurückgenommen, damit an der Oberkante ein schmaler Steg stehen bleibt statt einer null Millimeter dünnen Schneide, die sich nicht drucken lässt. Für den FDM-Druck ist das Spiel reichlich – Bins fallen weich hinein und sitzen trotzdem ohne Klappern.',
  },
  {
    q: 'Wie drucke ich die Grundplatte am besten?',
    a: 'Flach auf dem Druckbett, ohne Stützen – alle Überhänge des Fassungsprofils liegen bei 45° und tragen sich selbst. Üblich sind 0,2 mm Schichthöhe und 3 Perimeter. Bei der Variante ohne Boden ist die erste Schicht die tragende: Achte auf gute Haftung, weil die Platte nur aus schmalen Stegen besteht.',
  },
  {
    q: 'Passen die Platten zu Bins von anderen Konstrukteuren?',
    a: 'Ja, solange sich diese ebenfalls an die Spezifikation halten – genau dafür ist das offene System da. Das Fassungsprofil hier folgt den Maßblättern: 0,7 mm Fase, 1,8 mm gerade, 2,15 mm Fase auf 4,65 mm Gesamthöhe mit 4,0 mm Eckradius. Die Bins aus dem Bin-Generator passen naturgemäß ebenfalls.',
  },
];

const ld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: gen.title,
    url: new URL(path, SITE.url).href,
    description: gen.description,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Web',
    inLanguage: 'de-DE',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  breadcrumbLd(crumbs.map((c) => ({ name: c.name, path: c.href }))),
  faqLd(FAQ),
];

const DEFAULT: BaseplateSpec = { unitsX: 4, unitsY: 3, floor: 0, segments: 8 };
const initial = buildBaseplate(DEFAULT);

const nf = (n: number, dig = 1) => n.toLocaleString('de-DE', { maximumFractionDigits: dig });
const inputCls =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-zinc-900 shadow-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200';
const rowCls = 'flex items-baseline justify-between gap-4 border-b border-zinc-100 py-2.5 last:border-0';
const labelCls = 'mb-1 flex items-center justify-between text-sm font-medium text-zinc-700';
---

<BaseLayout
  title="Gridfinity-Grundplatten-Generator – Baseplate als STL"
  description={gen.description}
  path={path}
  ogType="article"
  jsonLd={ld}
>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <Breadcrumbs items={crumbs} />

    <header class="mt-4">
      <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900">Gridfinity-Grundplatten-Generator</h1>
      <p class="mt-2 text-lg text-zinc-600">
        Rastergröße wählen – der Generator baut die passende Grundplatte nach Spezifikation und gibt
        sie als druckfertiges STL aus. Optional mit Boden.
      </p>
    </header>

    <div class="mt-8 grid gap-6 lg:grid-cols-[300px_1fr]">
      <form id="bp-form" class="space-y-4" onsubmit="return false">
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Raster</h2>
          <div class="mt-3 space-y-4">
            <fieldset>
              <legend class="mb-1 text-sm font-medium text-zinc-700">Felder (X × Y)</legend>
              <div class="grid grid-cols-2 gap-2">
                <input id="bp-ux" type="number" value="4" min="1" max="20" step="1" aria-label="Felder in X" class={inputCls} />
                <input id="bp-uy" type="number" value="3" min="1" max="20" step="1" aria-label="Felder in Y" class={inputCls} />
              </div>
              <span class="mt-1 block text-xs text-zinc-500">je 42 mm</span>
            </fieldset>
            <label class="block">
              <span class={labelCls}><span>Bodenstärke</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="bp-floor" type="number" value="0" min="0" max="20" step="0.4" inputmode="decimal" class={inputCls} />
              <span class="mt-1 block text-xs text-zinc-500">0 = offener Rahmen (Standard)</span>
            </label>
          </div>
          <button id="bp-stl" type="button" class="mt-5 w-full rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-500">
            STL herunterladen
          </button>
          <a href="/generatoren/gridfinity-generator" class="mt-2 block rounded-lg border border-zinc-300 px-4 py-2 text-center text-sm font-semibold text-zinc-700 transition hover:bg-zinc-100">
            Passende Bins erzeugen
          </a>
        </div>
      </form>

      <div>
        <div id="bp-warn" hidden class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"></div>

        <figure class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm">
          <figcaption class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
            <span class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Vorschau</span>
            <span id="bp-name" class="font-mono text-xs text-zinc-500">{DEFAULT.unitsX}×{DEFAULT.unitsY}</span>
          </figcaption>
          <div id="bp-preview" class="h-72 w-full" set:html={baseplatePreviewSvg(DEFAULT)} />
        </figure>

        <div class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wide text-zinc-500">Maße & Material</h2>
          <div aria-live="polite" aria-atomic="true">
            <div class={rowCls + ' text-lg'}>
              <span class="font-semibold text-zinc-900">Außenmaß</span>
              <span id="bp-size" class="whitespace-nowrap font-mono font-semibold text-brand-700">{nf(initial.stats.size[0])} × {nf(initial.stats.size[1])} × {nf(initial.stats.size[2], 2)} mm</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Felder</span>
              <span id="bp-cells" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{initial.stats.cells}</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Fassungstiefe</span>
              <span class="whitespace-nowrap font-mono font-semibold text-zinc-900">{nf(PLATE.HEIGHT, 2)} mm</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Spiel je Seite <span class="block text-xs font-normal text-zinc-500">zum Bin</span></span>
              <span class="whitespace-nowrap font-mono font-semibold text-zinc-900">{nf(GF.CLEARANCE / 2 - SOCKET_RELIEF, 2)} mm</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Materialbedarf <span class="block text-xs font-normal text-zinc-500">massiv gerechnet, PLA</span></span>
              <span id="bp-mat" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{nf(initial.stats.volumeCm3, 2)} cm³ · {nf(initial.stats.volumeCm3 * 1.24)} g</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Dreiecke</span>
              <span id="bp-tris" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{initial.stats.triangles.toLocaleString('de-DE')}</span>
            </div>
          </div>
        </div>
        <p class="mt-2 text-xs text-zinc-500">
          Alles wird in deinem Browser berechnet – das Modell verlässt dein Gerät nicht.
        </p>
      </div>
    </div>

    <section class="prose-werkbank mt-12 max-w-none">
      <h2>Die Grundplatte ist das Raster</h2>
      <p>
        Gridfinity besteht aus zwei Teilen: den <strong>Bins</strong>, die deine Werkzeuge und
        Kleinteile aufnehmen, und der <strong>Grundplatte</strong>, in die sie einrasten. Erst die
        Grundplatte macht aus losen Behältern ein Ordnungssystem – nichts verrutscht mehr, alles
        bleibt bündig, und du kannst Bins beliebig umsortieren, ohne dass die Schublade zum Chaos
        wird. Jedes Feld misst <strong>42 × 42 mm</strong>, die Fassung ist <strong>4,65 mm</strong>
        tief und spiegelt exakt das Fußprofil der Bins.
      </p>
      <h3>Große Flächen aus mehreren Platten</h3>
      <p>
        Die Außenmaße sind exakte Vielfache von 42 mm – eine 4 × 3-Platte misst also genau
        168 × 126 mm. Dadurch lassen sich mehrere Platten <strong>nahtlos aneinanderlegen</strong>,
        um eine ganze Schublade auszukleiden, ohne dass an den Stößen ein Versatz entsteht. Das ist
        auch der praktische Weg für große Flächen: Statt eine Platte am Stück zu drucken, die kaum
        auf das Bett passt und stundenlang läuft, druckst du mehrere kleine und legst sie zusammen.
      </p>
      <h3>Ein Detail zur Druckbarkeit</h3>
      <p>
        Nach Spezifikation ist die Fassungsöffnung oben genau so groß wie das Rasterfeld. Zwei
        benachbarte Fassungen träfen sich dort also auf <strong>null Wandstärke</strong> – auf einer
        Schneide, die kein Drucker sauber ausführen kann. Dieser Generator nimmt die Fassung deshalb
        um 0,05 mm je Seite zurück: Oben bleibt ein schmaler Steg stehen, und das Spiel zum Bin
        beträgt 0,20 statt 0,25 mm. Für FDM-Druck ist das reichlich – die Bins fallen weich hinein
        und sitzen trotzdem ohne Klappern.
      </p>
      <h3>Passend weiterarbeiten</h3>
      <p>
        Die passenden Behälter liefert der <a href="/generatoren/gridfinity-generator">Gridfinity-Bin-Generator</a>.
        Wie viel Filament und Geld ein ganzer Satz kostet, rechnest du mit der
        <a href="/generatoren/stl-analyse">STL-Analyse</a> – dort kannst du die erzeugte Datei auch
        gleich auf Dichtheit prüfen. Für die Kalkulation passen die
        <a href="/rechner/filament-kosten">Filamentkosten</a> und die
        <a href="/rechner/druckpreis-kalkulation">Druckpreis-Kalkulation</a>.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900">Häufige Fragen</h2>
      <div class="mt-4 space-y-3">
        {
          FAQ.map((f) => (
            <details class="rounded-lg border border-zinc-200 bg-white p-4">
              <summary class="cursor-pointer font-medium text-zinc-800">{f.q}</summary>
              <p class="mt-2 text-zinc-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { buildBaseplate, baseplatePreviewSvg, toStl, type BaseplateSpec } from '../../lib/gridfinity';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const form = $('bp-form');
  const preview = $('bp-preview');
  const warnEl = $('bp-warn');

  const nf = (n: number, dig = 1) => n.toLocaleString('de-DE', { maximumFractionDigits: dig });
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function val(id: string, fallback: number, min: number, max: number): number {
    const el = $(id) as HTMLInputElement | null;
    if (!el) return fallback;
    const v = parseFloat(el.value.replace(',', '.'));
    return Number.isFinite(v) ? Math.min(Math.max(v, min), max) : fallback;
  }
  const setText = (id: string, t: string) => {
    const el = $(id);
    if (el) el.textContent = t;
  };

  const readSpec = (): BaseplateSpec => ({
    unitsX: val('bp-ux', 4, 1, 20),
    unitsY: val('bp-uy', 3, 1, 20),
    floor: val('bp-floor', 0, 0, 20),
    segments: 8,
  });

  let current: BaseplateSpec | null = null;

  function render(): void {
    const spec = readSpec();
    current = spec;
    const { stats } = buildBaseplate(spec);

    if (preview) preview.innerHTML = baseplatePreviewSvg(spec);
    setText('bp-name', `${Math.round(spec.unitsX)}×${Math.round(spec.unitsY)}`);
    setText('bp-size', `${nf(stats.size[0])} × ${nf(stats.size[1])} × ${nf(stats.size[2], 2)} mm`);
    setText('bp-cells', String(stats.cells));
    setText('bp-mat', `${nf(stats.volumeCm3, 2)} cm³ · ${nf(stats.volumeCm3 * 1.24)} g`);
    setText('bp-tris', stats.triangles.toLocaleString('de-DE'));

    if (warnEl) {
      warnEl.hidden = stats.warnings.length === 0;
      warnEl.innerHTML = stats.warnings.map((w) => `<p>${esc(w)}</p>`).join('');
    }
  }

  form?.addEventListener('input', render);
  form?.addEventListener('change', render);

  $('bp-stl')?.addEventListener('click', () => {
    if (!current) return;
    const { triangles } = buildBaseplate({ ...current, segments: 16 });
    const blob = new Blob([toStl(triangles, 'Werkbank Gridfinity Baseplate')], { type: 'model/stl' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `gridfinity-grundplatte-${Math.round(current.unitsX)}x${Math.round(current.unitsY)}.stl`;
    a.click();
    URL.revokeObjectURL(url);
  });

  render();
</script>

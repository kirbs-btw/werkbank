---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getGenerator } from '../../lib/generators';
import { breadcrumbLd, faqLd } from '../../lib/schema';
import { SITE } from '../../config/site';
import { buildHinge, bendPreviewSvg, type HingeSpec } from '../../lib/livinghinge';
import { writeSvg } from '../../lib/dxfsvg';

const gen = getGenerator('living-hinge')!;
const path = '/generatoren/living-hinge';
const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Generatoren', href: '/kategorie/generatoren' },
  { name: gen.shortTitle ?? gen.title, href: path },
];

const FAQ = [
  {
    q: 'Was ist ein Living Hinge?',
    a: 'Ein Living Hinge – auf Deutsch Biegescharnier oder Federscharnier – ist ein Muster aus versetzten Schnitten, das starres Plattenmaterial biegsam macht. Zwischen den Schnitten bleiben schmale Stege stehen; weil die Stege benachbarter Reihen auf Lücke sitzen, verdrehen sie sich beim Biegen leicht und die Platte krümmt sich, ohne zu brechen. Typische Anwendungen sind Gehäuse mit runden Ecken, Lampenschirme, Rolldeckel und Buchrücken.',
  },
  {
    q: 'Wie breit muss der Scharnierbereich sein?',
    a: 'So breit wie der gebogene Abschnitt lang ist. Der Generator rechnet dafür die Bogenlänge der neutralen Faser: Breite = (Innenradius + halbe Materialstärke) × Biegewinkel im Bogenmaß. Für eine 90°-Biegung mit 20 mm Innenradius in 3 mm Sperrholz sind das rund 33,8 mm. Ist der Bereich zu schmal, wird die Biegung zu eng und die Stege reißen.',
  },
  {
    q: 'Wie viele Reihen brauche ich?',
    a: 'Je mehr Reihen, desto weniger muss sich jeder einzelne Steg verdrehen und desto schonender wird die Biegung. Übliche Auslegungen für 3-mm-Sperrholz liegen bei etwa 5 bis 10° je Reihe – der Generator weist darauf hin, wenn es darüber hinausgeht. Einen harten Grenzwert gibt es nicht, weil Material, Dicke, Schlitzlänge und Stegbreite zusammenspielen. Mehr Reihen bedeuten allerdings auch mehr Schnittzeit und ein weicheres, weniger tragfähiges Scharnier.',
  },
  {
    q: 'Welche Schlitzlänge und welchen Steg soll ich wählen?',
    a: 'Bewährt sind Schlitze von 15 bis 30 mm und Stege von 2 bis 4 mm bei 3-mm-Sperrholz. Kurze Schlitze mit vielen Stegen ergeben ein festes, aber steiferes Scharnier; lange Schlitze biegen leichter, halten dafür weniger aus. Der Steg sollte nicht schmaler als die halbe Materialstärke sein, sonst bricht er beim Biegen aus.',
  },
  {
    q: 'Welches Material eignet sich?',
    a: 'Am besten funktioniert dünnes Sperrholz von 3 bis 4 mm, weil die Fasern die Verdrehung mitmachen. Auch Acryl lässt sich biegen, allerdings nur warm und mit deutlich mehr Reihen, da es sonst spröde bricht. MDF ist am kritischsten: Es hat keine Faserstruktur und reißt schnell – dort helfen kleinere Reihenabstände und ein größerer Radius. Ein Probestück lohnt sich immer.',
  },
  {
    q: 'Muss ich die Schnittfuge berücksichtigen?',
    a: 'Für das Muster selbst nicht: Die Schlitze sind reine Schnittlinien ohne Breite, der Laser erzeugt die Fuge von selbst. Wichtig wird die Fuge nur, wenn du zusätzlich Steckverbindungen an derselben Platte hast – dafür gibt es den separaten Kerf-Rechner. Die Fugenbreite vergrößert übrigens leicht die Beweglichkeit, weil sich die Schlitze weiter schließen können.',
  },
  {
    q: 'Werden meine Daten hochgeladen?',
    a: 'Nein. Muster und Vorschau entstehen komplett in deinem Browser, und die Dateien werden lokal erzeugt. Es wird nichts übertragen und nichts gespeichert.',
  },
];

const ld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: gen.title,
    url: new URL(path, SITE.url).href,
    description: gen.description,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Web',
    inLanguage: 'de-DE',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  breadcrumbLd(crumbs.map((c) => ({ name: c.name, path: c.href }))),
  faqLd(FAQ),
];

const DEFAULT: HingeSpec = {
  panelWidth: 120,
  panelHeight: 100,
  angle: 90,
  radius: 20,
  thickness: 3,
  slitLength: 20,
  gap: 3,
  rowSpacing: 2.5,
  margin: 2,
  outline: true,
};
const initial = buildHinge(DEFAULT);

const nf = (n: number, dig = 1) => n.toLocaleString('de-DE', { maximumFractionDigits: dig });
const inputCls =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-zinc-900 shadow-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200';
const rowCls = 'flex items-baseline justify-between gap-4 border-b border-zinc-100 py-2.5 last:border-0';
const labelCls = 'mb-1 flex items-center justify-between text-sm font-medium text-zinc-700';
---

<BaseLayout
  title="Living-Hinge-Generator – Biegescharnier für den Laser"
  description={gen.description}
  path={path}
  ogType="article"
  jsonLd={ld}
>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <Breadcrumbs items={crumbs} />

    <header class="mt-4">
      <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900">Living-Hinge-Generator</h1>
      <p class="mt-2 text-lg text-zinc-600">
        Biegewinkel, Radius und Materialstärke eingeben – der Generator berechnet die nötige Breite
        des Scharnierbereichs, verteilt die Schlitzreihen und gibt das Muster als SVG oder DXF aus.
      </p>
    </header>

    <div class="mt-8 grid gap-6 lg:grid-cols-[300px_1fr]">
      <form id="lh-form" class="space-y-4" onsubmit="return false">
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Biegung</h2>
          <div class="mt-3 space-y-4">
            <label class="block">
              <span class={labelCls}><span>Biegewinkel</span><span class="text-xs font-normal text-zinc-500">°</span></span>
              <input id="lh-angle" type="number" value="90" min="1" max="360" step="5" inputmode="decimal" class={inputCls} />
            </label>
            <label class="block">
              <span class={labelCls}><span>Innenradius</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="lh-radius" type="number" value="20" min="0" step="1" inputmode="decimal" class={inputCls} />
            </label>
            <label class="block">
              <span class={labelCls}><span>Materialstärke</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="lh-thickness" type="number" value="3" min="0.5" step="0.5" inputmode="decimal" class={inputCls} />
            </label>
          </div>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Platte & Muster</h2>
          <div class="mt-3 space-y-4">
            <fieldset>
              <legend class="mb-1 text-sm font-medium text-zinc-700">Platte (Breite × Höhe)</legend>
              <div class="grid grid-cols-2 gap-2">
                <input id="lh-pw" type="number" value="120" min="1" step="10" aria-label="Plattenbreite in mm" class={inputCls} />
                <input id="lh-ph" type="number" value="100" min="1" step="10" aria-label="Plattenhöhe in mm" class={inputCls} />
              </div>
              <span class="mt-1 block text-xs text-zinc-500">in mm – Breite läuft in Biegerichtung</span>
            </fieldset>
            <label class="block">
              <span class={labelCls}><span>Schlitzlänge</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="lh-slit" type="number" value="20" min="1" step="1" inputmode="decimal" class={inputCls} />
            </label>
            <label class="block">
              <span class={labelCls}><span>Steg zwischen Schlitzen</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="lh-gap" type="number" value="3" min="0.2" step="0.5" inputmode="decimal" class={inputCls} />
            </label>
            <label class="block">
              <span class={labelCls}><span>Reihenabstand</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="lh-spacing" type="number" value="2.5" min="0.5" step="0.5" inputmode="decimal" class={inputCls} />
            </label>
            <label class="block">
              <span class={labelCls}><span>Randabstand</span><span class="text-xs font-normal text-zinc-500">mm</span></span>
              <input id="lh-margin" type="number" value="2" min="0" step="0.5" inputmode="decimal" class={inputCls} />
              <span class="mt-1 block text-xs text-zinc-500">0 = Schlitze bis zur Plattenkante</span>
            </label>
            <label class="flex items-center gap-2">
              <input id="lh-outline" type="checkbox" checked class="h-4 w-4 accent-brand-600" />
              <span class="text-sm font-medium text-zinc-700">Plattenumriss mitzeichnen</span>
            </label>
          </div>
          <div class="mt-5 flex flex-col gap-2">
            <button id="lh-svg" type="button" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-500">SVG herunterladen</button>
            <button id="lh-dxf" type="button" class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-700 transition hover:bg-zinc-100">DXF herunterladen</button>
          </div>
        </div>
      </form>

      <div>
        <div id="lh-warn" hidden class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"></div>

        <figure class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm">
          <figcaption class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500">Schnittmuster</figcaption>
          <div id="lh-pattern" class="h-64 w-full" set:html={writeSvg(initial.drawing, { margin: 2, strokeWidth: 1, stroke: '#c2410c', responsive: true })} />
        </figure>

        <figure class="mt-4 rounded-xl border border-zinc-200 bg-white p-4 shadow-sm">
          <figcaption class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500">So biegt sich die Platte</figcaption>
          <div id="lh-bend" class="h-40 w-full" set:html={bendPreviewSvg(DEFAULT, initial.stats)} />
        </figure>

        <div class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
          <h2 class="mb-1 text-xs font-semibold uppercase tracking-wide text-zinc-500">Auslegung</h2>
          <div aria-live="polite" aria-atomic="true">
            <div class={rowCls + ' text-lg'}>
              <span class="font-semibold text-zinc-900">Scharnierbreite</span>
              <span id="lh-band" class="whitespace-nowrap font-mono font-semibold text-brand-700">{nf(initial.stats.bandWidth)} mm</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Reihen</span>
              <span id="lh-rows" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{initial.stats.rows} × {nf(initial.stats.actualSpacing, 2)} mm</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Winkel je Reihe <span class="block text-xs font-normal text-zinc-500">übliche Auslegung unter 10°</span></span>
              <span id="lh-angle-row" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{nf(initial.stats.anglePerRow, 2)}°</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Schlitze gesamt</span>
              <span id="lh-slits" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{initial.stats.slits}</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Schnittlänge <span class="block text-xs font-normal text-zinc-500">nur Scharnier, ohne Umriss</span></span>
              <span id="lh-cut" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{nf(initial.stats.cutLength / 1000, 2)} m</span>
            </div>
            <div class={rowCls}>
              <span class="text-zinc-600">Öffnung je Schlitz <span class="block text-xs font-normal text-zinc-500">außen im gebogenen Zustand</span></span>
              <span id="lh-open" class="whitespace-nowrap font-mono font-semibold text-zinc-900">{nf(initial.stats.openingPerRow, 2)} mm</span>
            </div>
          </div>
        </div>
        <p class="mt-2 text-xs text-zinc-500">
          Alles rechnet live im Browser – die Dateien verlassen dein Gerät nicht.
        </p>
      </div>
    </div>

    <section class="prose-werkbank mt-12 max-w-none">
      <h2>Wie ein Biegescharnier funktioniert</h2>
      <p>
        Ein <strong>Living Hinge</strong> macht starres Plattenmaterial biegsam, ohne es zu schwächen
        oder zu verkleben. Quer zur Biegerichtung liegen Reihen paralleler Schlitze; zwischen ihnen
        bleiben schmale <strong>Stege</strong> stehen. Weil die Stege benachbarter Reihen auf Lücke
        sitzen, verdreht sich beim Biegen jeder Steg nur ein kleines Stück – in Summe krümmt sich die
        Platte trotzdem weit. Der Reiz: Deckel, Gehäusewand und Scharnier entstehen in einem einzigen
        Schnitt, ohne Beschläge.
      </p>
      <h3>Die Breite folgt der Bogenlänge</h3>
      <p>
        Der häufigste Fehler ist ein zu schmaler Scharnierbereich. Wie viel Platz die Biegung
        braucht, ergibt sich aus der <strong>Bogenlänge der neutralen Faser</strong>: Sie liegt in der
        Mitte des Materials und ändert ihre Länge beim Biegen nicht. Daraus folgt
      </p>
      <p><strong>Breite = (Innenradius + Materialstärke / 2) × Biegewinkel im Bogenmaß</strong></p>
      <p>
        Für 90° um 20 mm Innenradius in 3 mm Sperrholz sind das (20 + 1,5) × π/2 ≈ 33,8 mm. Genau
        diesen Streifen füllt der Generator mit Schlitzreihen und zentriert ihn auf der Platte – der
        Rest bleibt starr.
      </p>
      <h3>Reihen, Stege und die Grenze der Belastbarkeit</h3>
      <p>
        Der <strong>Reihenabstand</strong> bestimmt, wie viele Reihen in den Streifen passen, und
        damit, wie viel Winkel auf jede einzelne Reihe entfällt. Als Faustwert aus der Laserpraxis
        liegen übliche Auslegungen unter <strong>10° je Reihe</strong>; darüber weist der Generator darauf hin. Einen harten Grenzwert gibt es nicht – er hängt von Material, Dicke, Schlitzlänge und Stegbreite ab. Der
        <strong>Steg</strong> zwischen zwei Schlitzen sollte nicht schmaler als die halbe
        Materialstärke werden, sonst reißt er beim Biegen aus. Und je länger die Schlitze, desto
        weicher wird das Scharnier – kurze Schlitze mit vielen Stegen halten mehr aus, biegen sich
        aber schwerer.
      </p>
      <h3>Material und Probeschnitt</h3>
      <p>
        Am gutmütigsten ist dünnes <strong>Sperrholz</strong> von 3 bis 4 mm, weil die Fasern die
        Verdrehung mitmachen. <strong>Acryl</strong> biegt sich nur warm und braucht deutlich mehr
        Reihen. <strong>MDF</strong> ist am kritischsten, da es keine Faserstruktur hat. Weil
        Materialcharge, Feuchte und Laserleistung stark hineinspielen, lohnt sich immer ein
        Probestreifen von etwa 30 × 100 mm, bevor du das ganze Werkstück schneidest.
      </p>
      <h3>Passend weiterrechnen</h3>
      <p>
        Die ausgegebene Schnittlänge ist die Grundlage für die
        <a href="/rechner/laser-schnittzeit">Laser-Schnittzeit</a> und die
        <a href="/rechner/laser-schnittkosten">Schnittkosten</a>. Hast du an derselben Platte
        Steckverbindungen, hilft die <a href="/rechner/kerf-kompensation">Kerf-Kompensation</a>.
        Fertige Konturen liefern der <a href="/generatoren/fingerzinken-box">Fingerzinken-Box-Generator</a>
        und der <a href="/generatoren/lochkreis">Lochkreis-Generator</a>; bestehende Zeichnungen
        wandelt der <a href="/generatoren/dxf-svg-konverter">DXF ⇄ SVG Konverter</a> um.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900">Häufige Fragen</h2>
      <div class="mt-4 space-y-3">
        {
          FAQ.map((f) => (
            <details class="rounded-lg border border-zinc-200 bg-white p-4">
              <summary class="cursor-pointer font-medium text-zinc-800">{f.q}</summary>
              <p class="mt-2 text-zinc-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { buildHinge, bendPreviewSvg, type HingeSpec } from '../../lib/livinghinge';
  import { writeSvg, writeDxf } from '../../lib/dxfsvg';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const form = $('lh-form');
  const warnEl = $('lh-warn');

  const nf = (n: number, dig = 1) => n.toLocaleString('de-DE', { maximumFractionDigits: dig });
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function val(id: string, fallback: number, min: number, max = Infinity): number {
    const el = $(id) as HTMLInputElement | null;
    if (!el) return fallback;
    const v = parseFloat(el.value.replace(',', '.'));
    return Number.isFinite(v) ? Math.min(Math.max(v, min), max) : fallback;
  }
  const setText = (id: string, t: string) => {
    const el = $(id);
    if (el) el.textContent = t;
  };

  function readSpec(): HingeSpec {
    return {
      panelWidth: val('lh-pw', 120, 1),
      panelHeight: val('lh-ph', 100, 1),
      angle: val('lh-angle', 90, 1, 360),
      radius: val('lh-radius', 20, 0),
      thickness: val('lh-thickness', 3, 0.5),
      slitLength: val('lh-slit', 20, 1),
      gap: val('lh-gap', 3, 0.2),
      rowSpacing: val('lh-spacing', 2.5, 0.5),
      margin: val('lh-margin', 2, 0),
      outline: ($('lh-outline') as HTMLInputElement | null)?.checked ?? true,
    };
  }

  let current: HingeSpec | null = null;
  let drawing: ReturnType<typeof buildHinge>['drawing'] | null = null;

  function render(): void {
    const spec = readSpec();
    current = spec;
    const { drawing: d, stats } = buildHinge(spec);
    drawing = d;

    const pattern = $('lh-pattern');
    if (pattern) {
      pattern.innerHTML = writeSvg(d, { margin: 2, strokeWidth: 1, stroke: '#c2410c', responsive: true });
    }
    const bend = $('lh-bend');
    if (bend) bend.innerHTML = bendPreviewSvg(spec, stats);

    setText('lh-band', `${nf(stats.bandWidth)} mm`);
    setText('lh-rows', `${stats.rows} × ${nf(stats.actualSpacing, 2)} mm`);
    setText('lh-angle-row', `${nf(stats.anglePerRow, 2)}°`);
    setText('lh-slits', String(stats.slits));
    setText('lh-cut', `${nf(stats.cutLength / 1000, 2)} m`);
    setText('lh-open', `${nf(stats.openingPerRow, 2)} mm`);

    const el = $('lh-angle-row');
    if (el) {
      el.className = `whitespace-nowrap font-mono font-semibold ${
        stats.anglePerRow > 10 ? 'text-amber-700' : 'text-zinc-900'
      }`;
    }
    if (warnEl) {
      warnEl.hidden = stats.warnings.length === 0;
      warnEl.innerHTML = stats.warnings.map((w) => `<p>${esc(w)}</p>`).join('');
    }
  }

  function download(name: string, data: string, type: string): void {
    const blob = new Blob([data], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    a.click();
    URL.revokeObjectURL(url);
  }

  form?.addEventListener('input', render);
  form?.addEventListener('change', render);
  $('lh-svg')?.addEventListener('click', () => {
    if (drawing) download('living-hinge.svg', writeSvg(drawing, { margin: 2, strokeWidth: 0.1 }), 'image/svg+xml');
  });
  $('lh-dxf')?.addEventListener('click', () => {
    if (drawing) download('living-hinge.dxf', writeDxf(drawing), 'application/dxf');
  });

  render();
</script>
